---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { listPosts } from '@lib/posts';
import { SITE, GUITAO } from '../config';

const allBlog = (await listPosts('blog')).sort((a, b) => b.date.localeCompare(a.date));
const allProjects = (await listPosts('project')).sort((a, b) => b.date.localeCompare(a.date));
const recentBlog = allBlog.slice(0, 6);
const recentProjects = allProjects.slice(0, 4);
---

<Base>
	<section class="section">
		<div class="section-head">
			<h2 class="section-title">最新杂谈</h2>
			<a class="section-more" href="/blog">全部 →</a>
		</div>
		<div id="post-list-container" class="post-list-container grid-mode">
			{recentBlog.map((p, i) => (
				<div class="post-card-item">
					<PostCard
						href={`/blog/${p.slug}`}
						title={p.title}
						description={p.description}
						date={p.date}
						tags={p.tags}
						cover={p.cover || GUITAO[i % GUITAO.length]}
						kind="文章"
					/>
				</div>
			))}
		</div>
	</section>

	<section class="section">
		<div class="section-head">
			<h2 class="section-title">星舰项目</h2>
			<a class="section-more" href="/projects">全部 →</a>
		</div>
		<div id="post-list-container" class="post-list-container grid-mode">
			{recentProjects.map((p, i) => (
				<div class="post-card-item">
					<PostCard
						href={`/projects/${p.slug}`}
						title={p.title}
						description={p.description}
						date={p.date}
						tags={p.tags}
						cover={p.cover || GUITAO[(i + 5) % GUITAO.length]}
						kind="项目"
					/>
				</div>
			))}
		</div>
	</section>
</Base>

<style>
	.section { margin-top: 2.5rem; }
	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 1.4rem;
	}
	.section-title { font-size: 1.5rem; margin: 0; color: var(--deep-text); }
	.section-more { color: var(--primary); font-size: 0.9rem; text-decoration: none; }
	.section-more:hover { text-decoration: underline; }
</style>
