---
import Base from "../layouts/Base.astro";
import { listPosts } from "@lib/posts";

const posts = (await listPosts("blog")).sort((a, b) => b.date.localeCompare(a.date));

const byYear = new Map<number, typeof posts>();
for (const p of posts) {
	const y = new Date(p.date).getFullYear();
	if (!byYear.has(y)) byYear.set(y, []);
	byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
const total = posts.length;

const fmtDate = (d: string) => {
	const dt = new Date(d);
	return `${String(dt.getMonth() + 1).padStart(2, "0")}-${String(dt.getDate()).padStart(2, "0")}`;
};
---

<Base title="归档" description="全部文章的归档">
	<section class="mx-auto w-full max-w-3xl px-4 py-10 sm:px-6">
		<header class="mb-8">
			<h1 class="flex items-center gap-2 text-3xl font-bold text-[var(--deep-text)]">
				<span>🗂️</span> 归档
			</h1>
			<p class="mt-2 text-sm text-[var(--content-meta)]">共 {total} 篇文章。</p>
		</header>

		{
			years.map((year) => (
				<div class="mb-10">
					<div class="mb-3 flex items-baseline gap-3 border-b border-[var(--line-divider)] pb-2">
						<span class="text-2xl font-bold text-[var(--primary)]">{year}</span>
						<span class="text-xs text-[var(--content-meta)]">
							{byYear.get(year)!.length} 篇
						</span>
					</div>
					<ul class="space-y-1">
						{byYear.get(year)!.map((p) => (
							<li>
								<a
									href={`/blog/${encodeURIComponent(p.slug)}`}
									class="group flex items-center gap-3 rounded-lg px-2 py-1.5 transition hover:bg-[var(--btn-plain-bg-hover)]"
								>
									<span class="w-12 shrink-0 font-mono text-xs text-[var(--content-meta)]">
										{fmtDate(p.date ?? p.date)}
									</span>
									<span class="flex-1 truncate text-sm text-[var(--deep-text)] group-hover:text-[var(--primary)]">
										{p.title}
									</span>
									{p.tags && p.tags[0] && (
										<span class="hidden shrink-0 rounded bg-[var(--btn-regular-bg)] px-2 py-0.5 text-[11px] text-[var(--btn-content)] sm:inline">
											{p.tags[0]}
										</span>
									)}
								</a>
							</li>
						))}
					</ul>
				</div>
			))
		}

		{
			total === 0 && (
				<p class="rounded-xl border border-[var(--line-divider)] bg-[var(--card-bg)]/60 p-8 text-center text-[var(--content-meta)]">
					还没有文章，去写一篇吧～
				</p>
			)
		}
	</section>
</Base>
