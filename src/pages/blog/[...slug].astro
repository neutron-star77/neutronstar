---
import Base from '../../layouts/Base.astro';
import { getPost } from '@lib/posts';
import { renderMarkdown, extractHeadings } from '@lib/markdown';
import Giscus from '../../components/Giscus.astro';

const { slug } = Astro.params;
const post = slug ? await getPost('blog', slug) : null;
if (!post) return Astro.redirect('/404');

const html = renderMarkdown(post.content);
const headings = extractHeadings(post.content);
const dateStr = post.date.slice(0, 10);
---

<Base title={post.title} description={post.description} image={post.cover} headings={headings} sidebar>
  <article class="post-container card-base onload-animation">
    <header class="post-header">
      <h1 class="post-title">{post.title}</h1>
      <div class="post-meta">
        <span class="material-symbols-rounded">event</span>
        <time datetime={dateStr}>{dateStr}</time>
        {post.category && <span class="post-cat">{post.category}</span>}
      </div>
      {post.tags.length > 0 && (
        <div class="post-tags">
          {post.tags.map((t) => <a class="post-tag" href={`/tags/${encodeURIComponent(t)}`}>#{t}</a>)}
        </div>
      )}
    </header>
    <div class="post-content" set:html={html} />
    <Giscus />
  </article>
</Base>
