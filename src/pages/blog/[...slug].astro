---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import { SITE, bannerFor } from '../../config';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const banner = bannerFor(entry.id);
const { Content } = await render(entry);
---

<Base title={entry.data.title} description={entry.data.description} image={entry.data.cover || banner}>
  <article class="post">
    <div class="post-banner" style={`--banner-img:url(${banner})`}></div>
    <div class="post-head">
      <h1 class="post-title">{entry.data.title}</h1>
      <div class="post-meta">
        <time datetime={entry.data.pubDate.toISOString()}>{entry.data.pubDate.toLocaleDateString('zh-CN')}</time>
        {entry.data.tags?.map((t) => <a class="chip" href={`/tags/${encodeURIComponent(t)}`}>#{t}</a>)}
      </div>
    </div>
    <div class="post-body">
      <div class="prose"><Content /></div>
      <Toc headings={entry.data.headings ?? []} />
    </div>
  </article>
</Base>

<style>
  .post { padding: 0 0 2.2rem; overflow: hidden; }
  .post-banner {
    height: 8.5rem;
    margin-bottom: 1.8rem;
    background-image:
      linear-gradient(120deg, color-mix(in oklab, var(--page-bg) 58%, transparent), color-mix(in oklab, var(--page-bg) 38%, transparent)),
      radial-gradient(120% 140% at 0% 0%, color-mix(in oklab, var(--color-neon) 55%, transparent), transparent 60%),
      radial-gradient(120% 140% at 100% 0%, oklch(0.7 0.16 320 / 0.5), transparent 60%),
      var(--banner-img, none);
    background-size: cover;
    background-position: center;
    border-bottom: 1px solid var(--color-border);
  }
  .post-head { padding-inline: 2.2rem; margin-bottom: 1.4rem; }
  .post-title { font-size: 2rem; margin: 0 0 0.6rem; }
  .post-meta { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; color: var(--color-muted); font-size: 0.85rem; }
  .post-body { display: grid; grid-template-columns: 1fr 15rem; gap: 2rem; padding-inline: 2.2rem; }
  .prose { min-width: 0; }
  @media (max-width: 900px) { .post-body { grid-template-columns: 1fr; } }
</style>
