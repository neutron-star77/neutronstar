---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { GUITAO } from '../../config';

const entries = (await getCollection('diary')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const bannerImg = GUITAO[10];
---

<Base title="日记" description="航行日志">
  <div class="page-banner" style={`--banner-img:url(${bannerImg})`}></div>
  <h1 class="page-title">日记 <span class="neon-text">/ Diary</span></h1>
  <p class="page-sub">随手记录的星舰日常</p>
  <div class="timeline">
    {entries.map(async (d) => {
      const { Content } = await render(d);
      return (
        <article class="tl-item glass">
          <div class="tl-date">{d.data.date.toLocaleDateString('zh-CN')}</div>
          <div class="tl-body">
            <h3 class="tl-title">{d.data.title}</h3>
            {d.data.mood && <span class="chip">{d.data.mood}</span>}
            <div class="prose tl-text"><Content /></div>
          </div>
        </article>
      );
    })}
  </div>
</Base>

<style>
  .page-title { font-size: 2.2rem; margin: 0; }
  .page-sub { color: var(--color-muted); margin: 0.4rem 0 2rem; }
  .timeline { display: grid; gap: 1.2rem; }
  .tl-item { padding: 1.3rem 1.5rem; display: grid; grid-template-columns: 8rem 1fr; gap: 1rem; }
  .tl-date { color: var(--color-neon); font-family: var(--font-mono); font-size: 0.85rem; }
  .tl-title { margin: 0 0 0.5rem; font-size: 1.15rem; }
  .tl-text { font-size: 0.95rem; color: var(--color-muted); }
  @media (max-width: 640px) { .tl-item { grid-template-columns: 1fr; } }
</style>
