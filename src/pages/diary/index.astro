---
import Base from '../../layouts/Base.astro';
import { listPosts } from '@lib/posts';
import { renderMarkdown } from '@lib/markdown';
import { SITE } from '../../config';

const diaries = (await listPosts('diary')).sort((a, b) => b.date.localeCompare(a.date));
const rendered = diaries.map((d) => ({ ...d, html: renderMarkdown(d.content) }));
---

<Base title="说说" description="一些零碎的想法">
  <h1 class="page-title">说说 <span class="page-en">/ Diary</span></h1>
  <div class="timeline">
    {rendered.map((d) => (
      <div class="diary card-base">
        <div class="diary-date">{new Date(d.date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' })}</div>
        <div class="prose diary-body" set:html={d.html}></div>
        {d.tags?.length > 0 && (
          <div class="diary-tags">
            {d.tags.map((t) => <span class="tag">#{t}</span>)}
          </div>
        )}
      </div>
    ))}
  </div>
</Base>

<style>
  .page-title { font-size: 2.2rem; margin: 0 0 1.6rem; color: var(--deep-text); }
  .page-en { color: var(--content-meta); font-weight: 400; font-size: 1.3rem; }
  .timeline { display: grid; gap: 1.2rem; }
  .diary { padding: 1.4rem 1.6rem; border-left: 3px solid var(--primary); }
  .diary-date { color: var(--content-meta); font-size: 0.85rem; margin-bottom: 0.5rem; }
  .diary-body { color: var(--deep-text); line-height: 1.7; }
  .diary-tags { margin-top: 0.8rem; display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .tag { background: var(--btn-regular-bg); color: var(--btn-content); padding: 0.1rem 0.5rem; border-radius: 999px; font-size: 0.72rem; }
</style>
