---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { listPosts } from '@lib/posts';

const { tag } = Astro.params;
const all = await listPosts();
const posts = all
  .filter((p) => p.tags.includes(tag ?? ''))
  .sort((a, b) => b.date.localeCompare(a.date));
---

<Base title={`#${tag}`} description={`标签 ${tag} 下的文章`}>
  <h1 class="page-title">#<span class="page-tag">{tag}</span></h1>
  <p class="page-sub">{posts.length} 篇</p>
  <div class="grid">
    {posts.map((p) => (
      <PostCard
        href={`/${p.type}/${p.slug}`}
        title={p.title}
        description={p.description}
        date={p.date}
        tags={p.tags}
        cover={p.cover}
        kind={p.type === 'x' ? '博客' : p.type === 'project' ? '项目' : '博客'}
      />
    ))}
  </div>
  <p class="back"><a href="/tags">← 全部标签</a></p>
</Base>

<style>
  .page-title { font-size: 2.2rem; margin: 0; color: var(--deep-text); }
  .page-tag { color: var(--primary); }
  .page-sub { color: var(--content-meta); margin: 0.4rem 0 2rem; }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.2rem; }
  .back { margin-top: 2rem; }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr; } }
</style>
