---
import Base from '../../layouts/Base.astro';
import { allTags } from '@lib/posts';

const tags = await allTags();
---

<Base title="标签" description="全部标签">
  <h1 class="page-title">标签 <span class="page-en">/ Tags</span></h1>
  <p class="page-sub">共 {tags.length} 个标签</p>
  <div class="cloud">
    {tags.map(([tag, n]) => (
      <a class="tag-pill" href={`/tags/${encodeURIComponent(tag)}`}>#{tag}<sup>{n}</sup></a>
    ))}
  </div>
</Base>

<style>
  .page-title { font-size: 2.2rem; margin: 0; color: var(--deep-text); }
  .page-en { color: var(--content-meta); font-weight: 400; font-size: 1.3rem; }
  .page-sub { color: var(--content-meta); margin: 0.4rem 0 2rem; }
  .cloud { display: flex; flex-wrap: wrap; gap: 0.8rem; }
  .tag-pill {
    padding: 0.5rem 1rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--primary) 10%, transparent);
    color: var(--btn-content);
    font-weight: 500;
    transition: background 0.2s, transform 0.2s;
  }
  .tag-pill:hover {
    background: color-mix(in oklab, var(--primary) 22%, transparent);
    transform: translateY(-2px);
  }
  .tag-pill sup { color: var(--content-meta); margin-left: 0.2rem; }
</style>
