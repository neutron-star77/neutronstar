---
import Base from '../layouts/Base.astro';
---

<Base title="404" description="页面未找到">
  <section class="nf">
    <h1>404</h1>
    <p>信号丢失 · 这片星域没有可导航的页面</p>
    <a class="back-btn" href="/">返回母港</a>
  </section>
</Base>

<style>
  .nf { text-align: center; padding-block: 6rem; }
  .nf h1 { font-size: 5rem; margin: 0; color: var(--deep-text); }
  .nf p { color: var(--content-meta); margin: 1rem 0 2rem; }
  .back-btn {
    display: inline-block;
    padding: 0.6rem 1.6rem;
    border-radius: 999px;
    background: var(--btn-regular-bg);
    color: var(--btn-content);
    font-weight: 600;
    transition: background 0.2s;
  }
  .back-btn:hover { background: var(--btn-regular-bg-hover); }
</style>
