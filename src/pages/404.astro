---
import Base from '../layouts/Base.astro';
import NeonButton from '../components/NeonButton.astro';
---

<Base title="404" description="页面未找到">
  <section class="nf">
    <h1 class="neon-text">404</h1>
    <p>信号丢失 · 这片星域没有可导航的页面</p>
    <NeonButton href="/">返回母港</NeonButton>
  </section>
</Base>

<style>
  .nf { text-align: center; padding-block: 6rem; }
  .nf h1 { font-size: 5rem; margin: 0; }
  .nf p { color: var(--color-muted); margin: 1rem 0 2rem; }
</style>
