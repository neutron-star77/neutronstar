---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { listPosts } from '@lib/posts';
import { SITE, GUITAO } from '../../config';

const projects = (await listPosts('project')).sort((a, b) => b.date.localeCompare(a.date));
---

<Base title="项目" description="星舰搭载的项目">
  <h1 class="page-title">项目 <span class="page-en">/ Projects</span></h1>
  <p class="page-sub">共 {projects.length} 个项目</p>
  <div class="grid">
    {projects.map((p, i) => (
      <PostCard href={`/projects/${p.slug}`} title={p.title} description={p.description}
        date={p.date} tags={p.tags} cover={p.cover || GUITAO[(i + 3) % GUITAO.length]} kind="项目" />
    ))}
  </div>
</Base>

<style>
  .page-title { font-size: 2.2rem; margin: 0; color: var(--deep-text); }
  .page-en { color: var(--content-meta); font-weight: 400; font-size: 1.3rem; }
  .page-sub { color: var(--content-meta); margin: 0.4rem 0 2rem; }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.2rem; }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr; } }
</style>
