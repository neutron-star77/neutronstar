---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { SITE, GUITAO } from '../../config';

const projects = (await getCollection('project')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const bannerImg = GUITAO[6];
---

<Base title="项目" description="星舰搭载的项目">
  <div class="page-banner" style={`--banner-img:url(${bannerImg})`}></div>
  <h1 class="page-title">项目 <span class="neon-text">/ Projects</span></h1>
  <p class="page-sub">共 {projects.length} 个项目</p>
  <div class="grid">
    {projects.map((p, i) => (
      <PostCard href={`/projects/${p.id}`} title={p.data.title} description={p.data.description}
        date={p.data.date} tags={p.data.tags} cover={p.data.cover || GUITAO[(i + 3) % GUITAO.length]} kind="项目" />
    ))}
  </div>
</Base>

<style>
  .page-title { font-size: 2.2rem; margin: 0; }
  .page-sub { color: var(--color-muted); margin: 0.4rem 0 2rem; }
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.2rem; }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr; } }
</style>
