---
import Base from '../../layouts/Base.astro';
import { getPost } from '@lib/posts';
import { renderMarkdown, extractHeadings } from '@lib/markdown';

const { slug } = Astro.params;
const project = slug ? await getPost('project', slug) : null;
if (!project) return Astro.redirect('/404');

const html = renderMarkdown(project.content);
const headings = extractHeadings(project.content);
const dateStr = project.date.slice(0, 10);
---

<Base title={project.title} description={project.description} image={project.cover} headings={headings} sidebar>
  <article class="post-container card-base onload-animation">
    <header class="post-header">
      <h1 class="post-title">{project.title}</h1>
      <div class="post-meta">
        <span class="material-symbols-rounded">event</span>
        <time datetime={dateStr}>{dateStr}</time>
        {project.category && <span class="post-cat">{project.category}</span>}
      </div>
      {project.tags.length > 0 && (
        <div class="post-tags">
          {project.tags.map((t) => <a class="post-tag" href={`/tags/${encodeURIComponent(t)}`}>#{t}</a>)}
        </div>
      )}
    </header>
    <div class="post-content" set:html={html} />
  </article>
</Base>
