---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { SITE, bannerFor } from '../../config';

export async function getStaticPaths() {
  const projects = await getCollection('project');
  return projects.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const banner = bannerFor(entry.id);
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth >= 2 && h.depth <= 3);
---

<Base
  title={entry.data.title}
  description={entry.data.description}
  image={entry.data.cover || banner}
  headings={toc}
  banner={banner}
>
  <article class="post">
    <div class="post-head">
      <h1 class="post-title">{entry.data.title}</h1>
      <div class="post-meta">
        <time datetime={entry.data.date.toISOString()}>{entry.data.date.toLocaleDateString('zh-CN')}</time>
        {entry.data.tags?.map((t) => <a class="chip" href={`/tags/${encodeURIComponent(t)}`}>#{t}</a>)}
        {entry.data.link && <a class="chip" href={entry.data.link} target="_blank" rel="noopener">主页 ↗</a>}
        {entry.data.repo && <a class="chip" href={entry.data.repo} target="_blank" rel="noopener">仓库 ↗</a>}
      </div>
    </div>
    <div class="post-body card-base">
      <div class="prose"><Content /></div>
    </div>
  </article>
</Base>

<style>
  .post { padding: 0; }
  .post-head { margin-bottom: 1.4rem; }
  .post-title { font-size: 2rem; margin: 0 0 0.6rem; color: var(--deep-text); }
  .post-meta { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; color: var(--content-meta); font-size: 0.85rem; }
  .chip {
    background: var(--btn-regular-bg);
    color: var(--btn-content);
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    transition: background 0.15s;
  }
  .chip:hover { background: var(--btn-regular-bg-hover); }
  .post-body { padding: 1.8rem 2rem; }
  .prose { min-width: 0; }
</style>
