---
import { listPosts, allTags } from "@lib/posts";
import { getSettings } from "@lib/settings";
import { SITE, SOCIAL } from "../config";

const all = await listPosts();
const blog = all.filter((p) => p.type === "blog");
const diary = all.filter((p) => p.type === "diary");
const project = all.filter((p) => p.type === "project");

const tags = (await allTags()).slice(0, 24);
const postCount = all.length;

const categories = [
	{ name: "杂谈", icon: "forum", count: blog.length, link: "/blog" },
	{ name: "说说", icon: "auto_stories", count: diary.length, link: "/diary" },
	{ name: "项目", icon: "code", count: project.length, link: "/projects" },
];

const siteStart = new Date("2025-01-01");
const days = Math.floor((Date.now() - siteStart.getTime()) / 86400000);

const settings = await getSettings();
const showSiteStats = settings.show_site_stats !== "0";

const socials = [
	{ icon: "code", label: "GitHub", href: SOCIAL.github },
	{ icon: "mail", label: "Email", href: SOCIAL.email },
	{ icon: "rss_feed", label: "RSS", href: SOCIAL.rss },
];
---

<aside class="sidebar" aria-label="侧边栏">
	<section class="card-base widget profile">
		<img class="avatar" src="/favicon.svg" alt={SITE.title} />
		<div class="p-name">{SITE.title}</div>
		<div class="p-sub">{SITE.subtitle}</div>
		<div class="p-socials">
			{
				socials.map((s) => (
					<a class="p-social" href={s.href} target="_blank" rel="noopener" title={s.label} aria-label={s.label}>
						<span class="material-symbols-rounded text-[1.1rem]">{s.icon}</span>
					</a>
				))
			}
		</div>
	</section>

	<section class="card-base widget">
		<h3 class="widget-title"><span class="material-symbols-rounded text-[1.15rem]">category</span>分类</h3>
		<ul class="cat-list">
			{
				categories.map((c) => (
					<li>
						<a href={c.link} class="cat-item">
							<span class="material-symbols-rounded text-[1.1rem]">{c.icon}</span>
							<span class="cat-name">{c.name}</span>
							<span class="cat-num">{c.count}</span>
						</a>
					</li>
				))
			}
		</ul>
	</section>

	<section class="card-base widget">
		<h3 class="widget-title"><span class="material-symbols-rounded text-[1.15rem]">sell</span>标签</h3>
		<div class="tag-cloud">
			{
				tags.map((t) => (
					<a class="tag-item" href={`/tags/${encodeURIComponent(t.tag)}`} style={`--w:${Math.min(1, 0.55 + t.count * 0.12)}`}>
						#{t.tag}
						<sup>{t.count}</sup>
					</a>
				))
			}
		</div>
	</section>

	{
		showSiteStats && (
			<section class="card-base widget">
				<h3 class="widget-title"><span class="material-symbols-rounded text-[1.15rem]">monitoring</span>站点统计</h3>
				<ul class="stats">
					<li><span class="material-symbols-rounded text-[1.1rem]">article</span><span>文章</span><span class="num">{postCount}</span></li>
					<li><span class="material-symbols-rounded text-[1.1rem]">label</span><span>标签</span><span class="num">{tags.length}</span></li>
					<li><span class="material-symbols-rounded text-[1.1rem]">calendar_month</span><span>建站</span><span class="num">{days}</span><span>天</span></li>
				</ul>
			</section>
		)
	}
</aside>

<style>
	.sidebar {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		position: sticky;
		top: 5.5rem;
		align-self: start;
	}
	.widget { padding: 1.1rem 1.2rem; }
	.widget-title {
		display: flex; align-items: center; gap: 0.4rem;
		margin: 0 0 0.9rem; font-size: 1rem; color: var(--deep-text);
	}
	.widget-title .text-[1.15rem] { color: var(--primary); }

	.profile { text-align: center; }
	.avatar {
		width: 4.5rem; height: 4.5rem;
		border-radius: 50%;
		object-fit: cover;
		margin: 0 auto 0.6rem;
		border: 2px solid var(--line-divider);
	}
	.p-name { font-weight: 700; font-size: 1.1rem; }
	.p-sub { color: var(--content-meta); font-size: 0.85rem; margin-top: 0.2rem; }
	.p-socials { display: flex; justify-content: center; gap: 0.5rem; margin-top: 0.8rem; }
	.p-social {
		display: inline-flex; align-items: center; justify-content: center;
		width: 2.2rem; height: 2.2rem;
		border-radius: 50%;
		background: var(--btn-regular-bg);
		color: var(--btn-content);
		transition: background 0.2s;
	}
	.p-social:hover { background: var(--btn-regular-bg-hover); }

	.cat-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.3rem; }
	.cat-item {
		display: flex; align-items: center; gap: 0.6rem;
		padding: 0.45rem 0.6rem; border-radius: 0.6rem;
		color: var(--deep-text); transition: background 0.15s;
	}
	.cat-item:hover { background: var(--btn-plain-bg-hover); color: var(--primary); }
	.cat-item .text-[1.1rem] { color: var(--primary); }
	.cat-name { flex: 1; font-weight: 500; }
	.cat-num { color: var(--content-meta); font-size: 0.85rem; }

	.tag-cloud { display: flex; flex-wrap: wrap; gap: 0.4rem; }
	.tag-item {
		font-size: calc(0.72rem + 0.18rem * var(--w, 1));
		padding: 0.2rem 0.6rem;
		border-radius: 999px;
		background: color-mix(in oklab, var(--primary) 10%, transparent);
		color: var(--btn-content);
		transition: background 0.2s;
	}
	.tag-item:hover { background: color-mix(in oklab, var(--primary) 22%, transparent); }
	.tag-item sup { font-size: 0.65em; opacity: 0.7; }

	.stats { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.55rem; }
	.stats li {
		display: flex; align-items: center; gap: 0.5rem;
		color: var(--content-meta); font-size: 0.88rem;
	}
	.stats li .text-[1.1rem] { color: var(--primary); }
	.stats .num { margin-left: auto; color: var(--deep-text); font-weight: 600; }
</style>
