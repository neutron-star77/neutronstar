---
import type { MarkdownHeading } from 'astro';

interface Props {
  headings: MarkdownHeading[];
}
const { headings } = Astro.props;
// 仅取 h2/h3
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
// 日假名角标（对标 Mizuki useJapaneseBadge）：あ/い/う… 给 h2，h3 用「母+序号」
const kana = ['あ', 'い', 'う', 'え', 'お', 'か', 'き', 'く', 'け', 'こ', 'さ', 'し', 'す', 'せ', 'そ', 'た', 'ち', 'つ', 'て', 'と'];
let h2i = -1;
const badge = (depth: number) => {
  if (depth === 2) {
    h2i++;
    return kana[h2i] ?? String(h2i + 1);
  }
  return kana[h2i] ?? '·';
};
---

{items.length > 0 && (
  <aside class="toc glass">
    <p class="toc-title">目录</p>
    <ul>
      {items.map((h) => (
        <li class:list={[`lv-${h.depth}`]}>
          <a href={`#${h.slug}`}>
            <span class="kana">{badge(h.depth)}</span>
            <span class="txt">{h.text}</span>
          </a>
        </li>
      ))}
    </ul>
  </aside>
)}

<style>
  .toc {
    padding: 1rem 1.1rem;
    position: sticky;
    top: 5.5rem;
    align-self: start;
    max-height: calc(100vh - 7rem);
    overflow: auto;
  }
  .toc-title {
    margin: 0 0 0.6rem;
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    color: var(--color-muted);
    text-transform: uppercase;
  }
  .toc ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
  .toc a { display: inline-flex; align-items: baseline; gap: 0.5rem; color: var(--color-muted); font-size: 0.85rem; }
  .toc a:hover { color: var(--color-neon); }
  .kana {
    flex: none;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--color-neon);
    background: color-mix(in oklab, var(--color-neon) 14%, transparent);
    border-radius: 0.4rem;
    min-width: 1.4rem;
    height: 1.4rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }
  .toc .lv-3 { padding-left: 0.2rem; }
  .toc .lv-3 .kana { background: transparent; color: var(--color-muted); min-width: 1.2rem; }
  @media (max-width: 1024px) {
    .toc { display: none; }
  }
</style>
