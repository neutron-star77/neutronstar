---
interface Props {
  class?: string;
  href?: string;
}
const { class: cls = '', href } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag class:list={['glass', 'glass-card', cls]} href={href}>
  <slot />
</Tag>

<style>
  .glass-card {
    display: block;
    padding: 1.25rem;
    transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s;
  }
  a.glass-card:hover {
    transform: translateY(-4px);
    border-color: var(--card-border);
    box-shadow: var(--neon-glow);
  }
</style>
