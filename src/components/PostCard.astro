---
interface Props {
	href: string;
	title: string;
	description?: string;
	date?: Date;
	tags?: string[];
	cover?: string;
	kind?: string;
}
const { href, title, description = '', date, tags = [], cover, kind } = Astro.props;
const fmt = (d?: Date) =>
	d ? d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }) : '';
---

<article class="card-base post-card">
	<a href={href} class="post-link">
		{cover && <img src={cover} alt={title} class="post-cover" loading="lazy" />}
		<div class="post-body">
			<div class="post-top">
				{kind && <span class="chip">{kind}</span>}
				{date && <time>{fmt(date)}</time>}
			</div>
			<h3 class="post-title">{title}</h3>
			{description && <p class="post-desc">{description}</p>}
			<div class="post-meta">
				{tags.length > 0 && (
					<span class="post-tags">
						{tags.map((t) => <a class="tag" href={`/tags/${encodeURIComponent(t)}`}>#{t}</a>)}
					</span>
				)}
			</div>
		</div>
	</a>
</article>

<style>
	.post-card { overflow: hidden; padding: 0; transition: transform 0.25s, box-shadow 0.25s; }
	.post-card:hover {
		transform: translateY(-4px);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
	}
	.post-link { display: block; }
	.post-cover {
		width: 100%;
		height: 11rem;
		object-fit: cover;
		border-bottom: 1px solid var(--line-divider);
	}
	.post-body { padding: 1.1rem 1.25rem 1.3rem; }
	.post-top { display: flex; align-items: center; gap: 0.6rem; color: var(--content-meta); font-size: 0.78rem; margin-bottom: 0.4rem; }
	.chip {
		background: var(--btn-regular-bg);
		color: var(--btn-content);
		padding: 0.1rem 0.5rem;
		border-radius: 999px;
		font-size: 0.7rem;
		font-weight: 600;
	}
	.post-title { margin: 0.3rem 0 0.4rem; font-size: 1.15rem; color: var(--deep-text); }
	.post-desc { color: var(--content-meta); font-size: 0.9rem; margin: 0 0 0.8rem; }
	.post-meta { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; color: var(--content-meta); font-size: 0.8rem; }
	.post-tags { display: inline-flex; gap: 0.4rem; flex-wrap: wrap; }
	.tag { color: var(--btn-content); transition: color 0.15s; }
	.tag:hover { color: var(--primary); }
</style>
