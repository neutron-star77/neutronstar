---
interface Props {
  href: string;
  title: string;
  description?: string;
  date?: Date;
  tags?: string[];
  cover?: string;
  kind?: string;
}
const { href, title, description = '', date, tags = [], cover, kind } = Astro.props;
const fmt = (d?: Date) =>
  d ? d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }) : '';
---

<article class="glass post-card">
  <a href={href} class="post-link">
    {cover && <img src={cover} alt={title} class="post-cover" loading="lazy" />}
    <div class="post-body">
      {kind && <span class="chip">{kind}</span>}
      <h3 class="post-title">{title}</h3>
      {description && <p class="post-desc">{description}</p>}
      <div class="post-meta">
        {date && <time>{fmt(date)}</time>}
        {tags.length > 0 && (
          <span class="post-tags">
            {tags.map((t) => <span class="tag">#{t}</span>)}
          </span>
        )}
      </div>
    </div>
  </a>
</article>

<style>
  .post-card { overflow: hidden; padding: 0; }
  .post-link { display: block; }
  .post-cover {
    width: 100%;
    height: 11rem;
    object-fit: cover;
    border-bottom: 1px solid var(--border);
  }
  .post-body { padding: 1.1rem 1.25rem 1.3rem; }
  .post-title { margin: 0.5rem 0 0.4rem; font-size: 1.15rem; }
  .post-desc { color: var(--muted); font-size: 0.9rem; margin: 0 0 0.8rem; }
  .post-meta { display: flex; flex-wrap: wrap; gap: 0.6rem; align-items: center; color: var(--muted); font-size: 0.8rem; }
  .post-tags { display: inline-flex; gap: 0.4rem; flex-wrap: wrap; }
  .tag { color: var(--primary); }
  .post-card:hover { transform: translateY(-4px); border-color: var(--card-border); box-shadow: var(--neon-glow); }
  .post-card { transition: transform 0.25s, box-shadow 0.25s, border-color 0.25s; }
</style>
