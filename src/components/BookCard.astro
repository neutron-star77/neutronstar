---
import type { Book } from "../data/books";

interface Props {
	book: Book;
}
const { book } = Astro.props;

const statusMap: Record<string, { text: string; cls: string }> = {
	reading: { text: "在读", cls: "bg-amber-400/90 text-black" },
	finished: { text: "读完", cls: "bg-emerald-400/90 text-black" },
	planned: { text: "想读", cls: "bg-zinc-400/90 text-black" },
};
const formatMap: Record<string, { text: string; cls: string }> = {
	pdf: { text: "PDF", cls: "bg-red-500/90 text-white" },
	txt: { text: "TXT", cls: "bg-sky-500/90 text-white" },
	epub: { text: "EPUB", cls: "bg-violet-500/90 text-white" },
};

const status = book.status ? statusMap[book.status] : null;
const fmt = formatMap[book.format] ?? { text: book.format.toUpperCase(), cls: "bg-zinc-500/90 text-white" };
const firstChar = (book.title || "书").slice(0, 1);
const rating = book.rating ?? 0;
---

<div
	class="group relative flex flex-col overflow-hidden rounded-xl border border-white/10 bg-[var(--color-surface)]/70 shadow-lg shadow-black/20 backdrop-blur-md transition duration-300 hover:-translate-y-1 hover:border-[var(--brand)]/50 hover:shadow-[var(--brand)]/20"
>
	<!-- 封面 -->
	<a
		href={book.file}
		target="_blank"
		rel="noopener"
		class="relative block aspect-[2/3] w-full overflow-hidden"
	>
		{
			book.cover ? (
				<img
					src={book.cover}
					alt={book.title}
					loading="lazy"
					class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
				/>
			) : (
				<div
					class="flex h-full w-full items-center justify-center bg-gradient-to-br from-[var(--brand)]/80 via-[var(--brand-2)]/70 to-[var(--brand-3)]/80 text-white"
				>
					<span class="select-none text-6xl font-black opacity-80 drop-shadow">
						{firstChar}
					</span>
				</div>
			)
		}
		<!-- 徽章 -->
		<div class="absolute left-2 top-2 flex gap-1.5">
			<span class={`rounded px-1.5 py-0.5 text-[11px] font-bold leading-none ${fmt.cls}`}>
				{fmt.text}
			</span>
			{
				status && (
					<span class={`rounded px-1.5 py-0.5 text-[11px] font-bold leading-none ${status.cls}`}>
						{status.text}
					</span>
				)
			}
		</div>
	</a>

	<!-- 信息 -->
	<div class="flex flex-1 flex-col gap-1.5 p-3">
		<h3 class="line-clamp-2 text-sm font-semibold text-[var(--color-text)]" title={book.title}>
			{book.title}
		</h3>
		{book.author && <p class="text-xs text-[var(--color-text-muted)]">@{book.author}</p>}
		{
			book.description && (
				<p class="line-clamp-2 text-xs leading-relaxed text-[var(--color-text-muted)]">
					{book.description}
				</p>
			)
		}
		{
			rating > 0 && (
				<p class="mt-0.5 text-xs text-amber-400" aria-label={`评分 ${rating} / 5`}>
					{"★".repeat(rating)}
					<span class="text-white/20">{"★".repeat(5 - rating)}</span>
				</p>
			)
		}
		<div class="mt-auto pt-2">
			<a
				href={book.file}
				target="_blank"
				rel="noopener"
				class="block w-full rounded-lg border border-[var(--brand)]/40 bg-[var(--brand)]/10 py-1.5 text-center text-xs font-medium text-[var(--brand)] transition hover:bg-[var(--brand)] hover:text-white"
			>
				阅读 / 下载
			</a>
		</div>
	</div>
</div>
